<Project Sdk="Microsoft.NET.Sdk">
  <!-- The dcl command and the only composition root (ADR-0001, ADR-0004). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dcl</AssemblyName>
    <RootNamespace>DcLedger.Cli</RootNamespace>
    <!-- Listed so the lock file covers self-contained publishing for linux-x64 (CI) and win-x64 (locally). -->
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <!-- The version option prints <version>+<commit>; scheduled workflows check it names the build they chose (ADR-0007). -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- Self-contained publish: dotnet publish src/DcLedger.Cli -c Release -p:DclPublishRid=linux-x64 (ci, ADR-0007).
       Set here, not with -r, because -r also reaches the libraries' locked restore, whose lock files have no runtime
       sections (NU1004). -->
  <PropertyGroup Condition="'$(DclPublishRid)' != ''">
    <RuntimeIdentifier>$(DclPublishRid)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DcLedger.Application\DcLedger.Application.csproj" />
    <ProjectReference Include="..\DcLedger.Domain\DcLedger.Domain.csproj" />
    <ProjectReference Include="..\DcLedger.Adapters.Legistar\DcLedger.Adapters.Legistar.csproj" />
    <ProjectReference Include="..\DcLedger.Infrastructure\DcLedger.Infrastructure.csproj" />
    <ProjectReference Include="..\DcLedger.Publishing\DcLedger.Publishing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DcLedger.Cli.Tests" />
  </ItemGroup>
</Project>
