---
// "Last checked" in Eastern plus a text-and-icon stale flag after 48 hours, or 7 days for a jurisdiction checked by
// hand (SPEC AC10, issue #27). The flag is words, not only an icon or a color. While fresh, the deadline is printed
// too, so a build that stops being replaced still tells the reader when to stop trusting it (issue #103).
import { easternText, staleAfterUtc, staleWindowText } from '../lib/radar.js';

interface Props {
  lastCheckedUtc: string | null;
  stale: boolean;
  staleAfterHours: number;
}

const { lastCheckedUtc, stale, staleAfterHours } = Astro.props;
const deadline =
  lastCheckedUtc === null || stale ? null : staleAfterUtc(lastCheckedUtc, staleAfterHours);
---

<p>
  {lastCheckedUtc === null ? (
    <span>Never checked.</span>
  ) : (
    <span>
      Last checked <time datetime={lastCheckedUtc}>{easternText(lastCheckedUtc)}</time>.
    </span>
  )}
  {deadline !== null && (
    <span class="deadline">
      {' '}
      If not checked again, it counts as stale after{' '}
      <time datetime={deadline}>{easternText(deadline)}</time>.
    </span>
  )}
  {stale && (
    <span class="flag">
      {' '}
      <span aria-hidden="true">⚠</span> Stale: no successful check in{' '}
      {staleWindowText(staleAfterHours)}.
    </span>
  )}
</p>
