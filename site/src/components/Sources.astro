---
// One item's provenance (SPEC AC2): each source URL, when it was retrieved (Eastern, with its zone) and the SHA-256 of
// the bytes kept. A copy a person saved in a browser says so in words (issue #113); a fetched one says nothing more.
// Shared by events and decisions so both show sources the same way. Official minutes and legislation pages may also
// show a reviewed picture of the first page of the copy kept (issue #132), lazy-loaded at a fixed size so nothing
// shifts when it arrives. The SHA-256 sits in a "More details" disclosure (a native <details>, so no script, AC12): it
// is still in the page for AC2 and for anyone checking a copy, but it no longer crowds the URL and retrieval time.
// A source link opens in a new tab, so a reader checking a document doesn't lose their place on the site; it says so
// with a visible arrow and, for screen readers, in words (WCAG 3.2.5 advisory, G201).
import { easternIso, easternText, retrievalText } from '../lib/radar.js';
import { pageOne } from '../lib/thumbnails.js';
import Glyph from './Glyph.astro';

interface Props {
  documents: {
    url: string;
    retrieved_utc: string;
    sha256: string;
    retrieval: 'fetched' | 'manual';
    kind: string | null;
    thumbnail: { path: string; width: number; height: number } | null;
  }[];
}

const { documents } = Astro.props;
---

<ol class="sources">
  {documents.map((document) => {
    const page = pageOne(document);
    return (
      <li class={page ? 'has-page' : undefined}>
        {page && (
          <figure class="page-one">
            <img
              src={page.src}
              width={page.width}
              height={page.height}
              alt={page.alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{page.caption}</figcaption>
          </figure>
        )}
        <dl>
          <dt>URL</dt>
          <dd>
            <a href={document.url} target="_blank" rel="external noopener noreferrer">
              {document.url}
              <span class="new-tab" aria-hidden="true">
                ↗
              </span>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </dd>
          <dt>Retrieved</dt>
          <dd>
            <time datetime={easternIso(document.retrieved_utc)}>
              {easternText(document.retrieved_utc)}
            </time>
          </dd>
          {retrievalText(document.retrieval) !== null && (
            <>
              <dt>How retrieved</dt>
              <dd>{retrievalText(document.retrieval)}.</dd>
            </>
          )}
        </dl>
        <details class="more-details">
          <summary>More details</summary>
          <dl>
            <dt>SHA-256</dt>
            <dd>
              <code>{document.sha256}</code>
              <Glyph sha256={document.sha256} />
            </dd>
          </dl>
          <p class="muted">
            <a href="/faq/#check-a-hash">How to check a hash</a>
          </p>
        </details>
      </li>
    );
  })}
</ol>
