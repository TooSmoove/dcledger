---
// Decisions such as a moratorium vote (issue #25, WS-AC8): what was decided, the recorded outcome and vote, how it is
// sourced (SPEC AC6), and its sources (AC2). Outcome words come from a fixed table, never from the source's text. The
// terms of an adopted decision (issue #115) follow, each only when its record states it. When the jurisdiction has a
// note on the record (such as a court order), each decision points to it first: a #decision- link lands below the
// note, and on a phone the note is then out of sight. A date the record states for the next step shows as a row, and
// any of the decision's known dates that has passed with nothing recorded is flagged (ADR-0010), linking its /ahead/
// row.
import type { CollectionEntry } from 'astro:content';
import { PASSED_UNRECORDED_TEXT, kindText } from '../lib/ahead.js';
import {
  actionTypeText,
  dateText,
  labelText,
  outcomeText,
  termRows,
  voteText,
} from '../lib/radar.js';
import Seats from './Seats.astro';
import Sources from './Sources.astro';

interface Props {
  actions: CollectionEntry<'actions'>[];
  heading: string;
  /** Link each decision to its meeting's page; off on the meeting's own page. */
  linkMeetings: boolean;
  /** The jurisdiction's note on the record, if it has one: where it is and whose it is. */
  note?: { href: string; jurisdictionName: string } | null;
  /** Known dates (site/src/lib/ahead.js) of these decisions; only those passed with nothing recorded are flagged. */
  knownDates?: {
    kind: 'expiry' | 'next';
    date: string;
    state: string;
    anchor: string;
    action: { id: string };
  }[];
}

const { actions, heading, linkMeetings, note = null, knownDates = [] } = Astro.props;
const passed = (actionId: string) =>
  knownDates.filter((k) => k.action.id === actionId && k.state === 'passed_unrecorded');
---

{actions.length > 0 && (
  <section aria-labelledby="decisions-heading" class="decisions">
    <h2 id="decisions-heading">{heading}</h2>
    {actions.map(({ id, data }) => (
      <article id={`decision-${id}`}>
        <h3>
          {actionTypeText(data.action_type)}: {outcomeText(data.outcome)}
        </h3>
        {note && (
          <p class="note-pointer">
            <strong>Also on the record:</strong> a note about {note.jurisdictionName}, with its
            sources. <a href={note.href}>Read the note</a>
          </p>
        )}
        {passed(id).map((k) => (
          <p class="flag">
            {kindText(k.kind)}, <time datetime={k.date}>{dateText(k.date)}</time>:{' '}
            {PASSED_UNRECORDED_TEXT} <a href={`/ahead/#${k.anchor}`}>Coming up on the record</a>
          </p>
        ))}
        <dl>
          <dt>Decided</dt>
          <dd>
            <time datetime={data.decided_on}>{dateText(data.decided_on)}</time>
          </dd>
          {(data.votes !== null || data.unanimous) && (
            <>
              <dt>Vote</dt>
              <dd>
                {voteText(data.votes, data.unanimous)}
                <Seats votes={data.votes} />
              </dd>
            </>
          )}
          {linkMeetings && data.event_id !== null && (
            <>
              <dt>Meeting</dt>
              <dd>
                <a href={`/items/${data.event_id}/`}>Meeting page</a>
              </dd>
            </>
          )}
          {termRows(data).map((row) => (
            <>
              <dt>{row.label}</dt>
              <dd>{row.date ? <time datetime={row.date}>{row.text}</time> : row.text}</dd>
            </>
          ))}
          {data.next_on !== null && (
            <>
              <dt>Date set for the next step</dt>
              <dd>
                <time datetime={data.next_on}>{dateText(data.next_on)}</time>
              </dd>
            </>
          )}
          {data.successor_id !== null && (
            <>
              <dt>Replaced or extended by</dt>
              <dd>
                <a href={`/jurisdictions/${data.jurisdiction_id}/#decision-${data.successor_id}`}>
                  Later decision
                </a>
              </dd>
            </>
          )}
          <dt>Sourcing</dt>
          <dd>{labelText(data.label)}</dd>
        </dl>
        <h4>Sources</h4>
        <Sources documents={data.documents} />
      </article>
    ))}
  </section>
)}
