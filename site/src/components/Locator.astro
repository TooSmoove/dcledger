---
// Where a jurisdiction is (issue #132, item 3): North Carolina, its county lines, and this jurisdiction filled, with a
// ring around one too small to see at state scale. Static SVG built from Census boundaries (public domain), so no
// script and no request (AC12, SPEC §E). The SVG is an image with an accessible name; the credit is visible text.
import boundaries from '../geo/nc-boundaries.json';
import { locatorFor } from '../lib/locator.js';

interface Props {
  id: string;
  name: string;
}

const { id, name } = Astro.props;
const locator = locatorFor(boundaries, id, name);
const titleId = `locator-${id}`;
---

{locator && (
  <figure class="locator">
    <svg viewBox={locator.viewBox} role="img" aria-labelledby={titleId} focusable="false">
      <title id={titleId}>{locator.label}</title>
      <path class="locator-state" d={locator.state} />
      <path class="locator-counties" d={locator.counties} />
      <path class="locator-area" d={locator.area} fill-rule="evenodd" />
      <path class="locator-state-line" d={locator.state} />
      {locator.ring && (
        <circle class="locator-ring" cx={locator.ring.cx} cy={locator.ring.cy} r={locator.ring.r} />
      )}
    </svg>
    <figcaption>{locator.credit}</figcaption>
  </figure>
)}
