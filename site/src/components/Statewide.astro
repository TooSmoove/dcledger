---
// The home page's statewide map (issue #132, item 7): North Carolina, its county lines, and every jurisdiction the
// ledger covers, filled solid when its hearings are watched and hatched when only its decisions are recorded, so the
// tier never rests on color alone (WCAG 1.4.1). Places draw over their counties; a place too small to see gets a ring.
// Static SVG from Census boundaries (public domain): no script and no request (AC12, SPEC §E). The SVG's accessible
// name says what it shows; the legend under it names each jurisdiction and links its page.
import { getCollection } from 'astro:content';
import boundaries from '../geo/nc-boundaries.json';
import { statewideFor } from '../lib/locator.js';

const jurisdictions = (await getCollection('jurisdictions'))
  .map((j) => ({ id: j.id, name: j.data.name, tier: j.data.coverage_tier }))
  .sort((a, b) => a.name.localeCompare(b.name, 'en'));
const map = statewideFor(boundaries, jurisdictions);
---

<figure class="statewide">
  <svg viewBox={map.viewBox} role="img" aria-labelledby="statewide-title" focusable="false">
    <title id="statewide-title">{map.label}</title>
    <defs>
      <pattern
        id="statewide-hatch"
        patternUnits="userSpaceOnUse"
        width="5"
        height="5"
        patternTransform="rotate(45)"
      >
        <rect class="statewide-hatch-ground" width="5" height="5" />
        <line class="statewide-hatch-line" x1="0" y1="0" x2="0" y2="5" />
      </pattern>
    </defs>
    <path class="locator-state" d={map.state} />
    <path class="locator-counties" d={map.counties} />
    {map.areas.map((area) => (
      <path
        class={`statewide-area statewide-${area.style} statewide-${area.kind}`}
        d={area.d}
        fill-rule="evenodd"
        data-jurisdiction={area.id}
      />
    ))}
    <path class="locator-state-line" d={map.state} />
    {map.rings.map((ring) => (
      <circle class="locator-ring" cx={ring.cx} cy={ring.cy} r={ring.r} />
    ))}
  </svg>
  <figcaption>
    <ul class="statewide-legend">
      {map.groups.map((group) => (
        <li>
          <svg class="statewide-swatch" viewBox="0 0 20 14" aria-hidden="true" focusable="false">
            <rect
              class={`statewide-area statewide-${group.style}`}
              x="0.5"
              y="0.5"
              width="19"
              height="13"
            />
          </svg>
          <span class="statewide-group">{group.text}:</span>{' '}
          {group.members.map((m, i) => (
            <>
              <a href={`/jurisdictions/${m.id}/`}>{m.name}</a>
              {i < group.members.length - 1 ? ', ' : ''}
            </>
          ))}
        </li>
      ))}
    </ul>
    <p class="statewide-credit">
      {map.credit}
      {map.rings.length > 0 && ' A ring marks a place too small to see at this scale.'}
    </p>
  </figcaption>
</figure>
