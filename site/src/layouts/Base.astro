---
// Every page: noindex (SPEC AC11), no script (AC12), a skip link and visible focus (WCAG 2.2 AA). The design is
// Claret (src/styles/claret.css, issue #133), inlined into each page so no page makes a second request for it.
// A page may pass a "masthead" slot: its title block, set on the burgundy band under the header.
import '../styles/claret.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const hasMasthead = Astro.slots.has('masthead');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#3d0f1f" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="NC Data Center Ledger: Hearing Radar"
      href="/feed.xml"
    />
    <title>{title} · NC Data Center Ledger</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header>
      <nav aria-label="Site">
        <a href="/">NC Data Center Ledger</a>
        <a href="/radar/">Hearing Radar</a>
        <a href="/map/">Map</a>
        <a href="/about/">About</a>
      </nav>
    </header>
    <main id="main">
      {hasMasthead && (
        <div class="masthead">
          <div class="wrap">
            <slot name="masthead" />
          </div>
        </div>
      )}
      <div class="wrap page">
        <slot />
      </div>
    </main>
    <footer>
      <p>
        Every item links to its official source with the retrieval time and the SHA-256 of the copy
        we kept. Times are Eastern. <a href="/about/">About this project</a>. How it works:{' '}
        <a href="/methodology/">Methodology and corrections</a>. Found a mistake?{' '}
        <a href="/report/">Report it</a>.
      </p>
    </footer>
  </body>
</html>
