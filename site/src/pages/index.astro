---
// The home page (issue #134): what the ledger is, then the record at a glance, every part built from the export so
// nothing on it is invented. A statewide map of every covered jurisdiction (Statewide.astro), then next up from the radar's window, decisions the record states are in effect, the latest
// decisions, coverage with freshness, and the feeds. An empty window says how many jurisdictions are watched and
// since when they were all checked, so "nothing scheduled" reads as a checked result; "What's new on the record"
// lists the records most recently added or updated, whatever their kind. A decision whose jurisdiction has a note on the record links the
// note too, and shows the first page of its first showable source when one has a reviewed picture. How to check the
// record lives on /faq/. No script (AC12).
import { getCollection } from 'astro:content';
import Freshness from '../components/Freshness.astro';
import Seats from '../components/Seats.astro';
import Statewide from '../components/Statewide.astro';
import WindowStrip from '../components/WindowStrip.astro';
import Base from '../layouts/Base.astro';
import {
  WINDOW_DAYS,
  actionTypeText,
  byDecisionNewestFirst,
  byStart,
  dateText,
  easternIso,
  easternText,
  inEffect,
  inWindow,
  isWatched,
  labelText,
  noteHref,
  outcomeText,
  recentlyUpdated,
  statusText,
  voteText,
  watchSummary,
  windowDays,
} from '../lib/radar.js';
import { generatedUtc } from '../lib/site-data-file.js';
import { pageOne } from '../lib/thumbnails.js';

const generated = await generatedUtc();
const jurisdictions = (await getCollection('jurisdictions')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'en'),
);
const names = new Map(jurisdictions.map((j) => [j.id, j.data.name]));
const watched = jurisdictions.filter((j) => isWatched(j.data.coverage_tier));
const others = jurisdictions.filter((j) => !isWatched(j.data.coverage_tier));
const COVERAGE_GROUPS = [
  ['decisions', 'Decisions only, hearings not watched'],
  ['registered', 'Listed only'],
] as const;
const upcoming = byStart(
  (await getCollection('events')).filter((event) => inWindow(event.data, generated)),
);
const next = upcoming.slice(0, 3);
const windowEnd = windowDays(generated, []).at(-1)?.iso ?? '';
const actions = await getCollection('actions');
const effective = inEffect(actions, generated);
const decisionHref = (a: (typeof actions)[number]) =>
  `/jurisdictions/${a.data.jurisdiction_id}/#decision-${a.id}`;
const watch = watchSummary(watched.map((j) => j.data));
const events = await getCollection('events');
const eventsById = new Map(events.map((e) => [e.id, e]));
const actionsById = new Map(actions.map((a) => [a.id, a]));
const nameOf = (id: string) => names.get(id) ?? id;
// Each recent record as the line the list prints: its date (Eastern), where it links, and what it is.
const recent = recentlyUpdated({ events, actions, jurisdictions }, 5).map((r) => {
  const date = easternIso(r.updatedUtc).slice(0, 10);
  if (r.kind === 'event') {
    const { data } = eventsById.get(r.id)!;
    return {
      date,
      href: `/items/${r.id}/`,
      text: data.title,
      detail: `Meeting. ${nameOf(data.jurisdiction_id)}, ${data.body}. ${statusText(data.status)}.`,
    };
  }
  if (r.kind === 'action') {
    const action = actionsById.get(r.id)!;
    const { data } = action;
    return {
      date,
      href: decisionHref(action),
      text: `${nameOf(data.jurisdiction_id)}: ${actionTypeText(data.action_type)}, ${outcomeText(data.outcome).toLowerCase()}`,
      detail: `Decision. ${labelText(data.label)}.`,
    };
  }
  return {
    date,
    href: noteHref(r.id),
    text: `${nameOf(r.id)}: note on the record`,
    detail: `Not a decision of ${nameOf(r.id)}.`,
  };
});
// Each latest decision with the first page of its first showable source (minutes or legislation; never a packet), or
// null: the same reviewed picture its jurisdiction page shows, at a smaller size.
const latest = byDecisionNewestFirst(actions)
  .slice(0, 3)
  .map((a) => ({ a, page: a.data.documents.map(pageOne).find((p) => p !== null) ?? null }));
// Jurisdictions with a note on the record (such as a court order): their decisions here point to it (#note).
const noted = new Set(jurisdictions.filter((j) => j.data.note !== null).map((j) => j.id));
---

<Base title="Home">
  <Fragment slot="masthead">
    <h1>Data-center hearings and decisions, on the record</h1>
    <p class="lede">North Carolina meetings and votes, each linked to its official source.</p>
    <p class="actions">
      <a class="btn" href="/radar/">
        Open the Hearing Radar
      </a>
      <a href="/faq/">How to check the record</a>
    </p>
  </Fragment>

  <section aria-labelledby="places-heading" class="home-section">
    <h2 id="places-heading">Places covered</h2>
    <Statewide />
  </section>

  <section aria-labelledby="next-heading" class="home-section">
    <h2 id="next-heading">Next up</h2>
    <WindowStrip generatedUtc={generated} events={upcoming} />
    {next.length === 0 ? (
      <p class="statement">
        Nothing scheduled through <time datetime={windowEnd}>{dateText(windowEnd)}</time> in the{' '}
        {watch.count} jurisdiction{watch.count === 1 ? '' : 's'} whose hearings we watch.{' '}
        {watch.checkedSinceUtc !== null ? (
          <span class="checked-since">
            Each was checked on or after{' '}
            <time datetime={watch.checkedSinceUtc}>{easternText(watch.checkedSinceUtc)}</time>.
          </span>
        ) : (
          <span class="checked-since">
            Some haven't been checked recently: see <a href="#coverage-heading">Coverage</a>.
          </span>
        )}
      </p>
    ) : (
      <ol class="next-list">
        {next.map(({ id, data }) => (
          <li class={data.status === 'cancelled' ? 'cancelled' : undefined}>
            <time datetime={easternIso(data.starts_utc)}>{easternText(data.starts_utc)}</time>
            <a class="item" href={`/items/${id}/`}>
              {data.title}
            </a>
            <span class="muted">
              {names.get(data.jurisdiction_id) ?? data.jurisdiction_id}, {data.body}.{' '}
              {labelText(data.label)}. {statusText(data.status)}.
            </span>
          </li>
        ))}
      </ol>
    )}
    {upcoming.length > 0 && (
      <p>
        <a href="/radar/">
          All {upcoming.length} item{upcoming.length === 1 ? '' : 's'} in the next {WINDOW_DAYS}{' '}
          days
        </a>
      </p>
    )}
  </section>

  <section aria-labelledby="new-heading" class="home-section">
    <h2 id="new-heading">What's new on the record</h2>
    <ol class="new-list">
      {recent.map((r) => (
        <li>
          <time datetime={r.date}>{dateText(r.date)}</time>
          <a class="item" href={r.href}>
            {r.text}
          </a>
          <span class="muted">{r.detail}</span>
        </li>
      ))}
    </ol>
    <p class="muted">
      Newest first, by when we last archived a source for the record. Each change is also in the{' '}
      <a href="/feed.xml">feed</a>.
    </p>
  </section>

  <section aria-labelledby="effect-heading" class="home-section">
    <h2 id="effect-heading">In effect now</h2>
    {effective.length === 0 ? (
      <p>No decision on record is stated to be in effect.</p>
    ) : (
      <ul class="effect-list">
        {effective.map((a) => (
          <li>
            <a href={decisionHref(a)}>
              {names.get(a.data.jurisdiction_id) ?? a.data.jurisdiction_id}:{' '}
              {actionTypeText(a.data.action_type).toLowerCase()}
            </a>
            <span class="effect-end">
              {a.data.expires_on === null ? (
                'No end date on record'
              ) : (
                <>
                  Ends <time datetime={a.data.expires_on}>{dateText(a.data.expires_on)}</time>
                </>
              )}
            </span>
            {a.data.threshold && <span class="muted">Applies to: “{a.data.threshold}”</span>}
            {noted.has(a.data.jurisdiction_id) && (
              <a class="note-link" href={noteHref(a.data.jurisdiction_id)}>
                See the note on the record
              </a>
            )}
          </li>
        ))}
      </ul>
    )}
    <p class="muted">Listed only when the official record states the decision is in effect.</p>
  </section>

  <section aria-labelledby="latest-heading" class="home-section">
    <h2 id="latest-heading">Latest decisions</h2>
    <ol class="latest-list">
      {latest.map(({ a, page }) => (
        <li class={page ? 'has-page' : undefined}>
          {page && (
            <img
              class="latest-page"
              src={page.src}
              width={page.width}
              height={page.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          )}
          <time datetime={a.data.decided_on}>{dateText(a.data.decided_on)}</time>
          <a class="item" href={decisionHref(a)}>
            {names.get(a.data.jurisdiction_id) ?? a.data.jurisdiction_id}:{' '}
            {actionTypeText(a.data.action_type)}, {outcomeText(a.data.outcome).toLowerCase()}
          </a>
          {(a.data.votes !== null || a.data.unanimous) && (
            <span class="muted">
              {voteText(a.data.votes, a.data.unanimous)}
              <Seats votes={a.data.votes} />
            </span>
          )}
          {noted.has(a.data.jurisdiction_id) && (
            <a class="note-link" href={noteHref(a.data.jurisdiction_id)}>
              See the note on the record
            </a>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="coverage-heading" class="home-section">
    <h2 id="coverage-heading">Coverage</h2>
    <ul class="freshness-list">
      {watched.map(({ id, data }) => (
        <li>
          <a href={`/jurisdictions/${id}/`}>{data.name}</a>
          <Freshness
            lastCheckedUtc={data.last_checked_utc}
            stale={data.stale}
            staleAfterHours={data.stale_after_hours}
          />
        </li>
      ))}
    </ul>
    {COVERAGE_GROUPS.map(([tier, words]) => {
      const group = others.filter((j) => j.data.coverage_tier === tier);
      return (
        group.length > 0 && (
          <p class="muted">
            {words}:{' '}
            {group.map(({ id, data }, i) => (
              <>
                {i > 0 && ', '}
                <a href={`/jurisdictions/${id}/`}>{data.name}</a>
              </>
            ))}
            .
          </p>
        )
      );
    })}
  </section>

  <section aria-labelledby="data-heading" class="home-section">
    <h2 id="data-heading">Use the data</h2>
    <dl class="data-list">
      <dt>
        <a href="/feed.xml">Feed (RSS)</a>
      </dt>
      <dd>One entry for each new, changed or cancelled item.</dd>
      <dt>
        <a href="/events.csv">Meetings CSV</a>, <a href="/actions.csv">Decisions CSV</a>
      </dt>
      <dd>For spreadsheets. Licensed CC BY 4.0.</dd>
      <dt>
        <a href="/events.parquet">Meetings Parquet</a>,{' '}
        <a href="/actions.parquet">Decisions Parquet</a>
      </dt>
      <dd>With native types, for analysis.</dd>
    </dl>
    <p>
      <a href="/data/">Data dictionary and stability promise</a>
    </p>
  </section>
</Base>
