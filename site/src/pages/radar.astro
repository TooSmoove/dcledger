---
// The Hearing Radar (SPEC AC1): every reviewed item starting within 30 days of the export, sorted by start, in
// Eastern time with its zone. "D" is events.json's generated_utc, so the same export always builds the same page.
import { getCollection } from 'astro:content';
import EventTable from '../components/EventTable.astro';
import Freshness from '../components/Freshness.astro';
import WindowStrip from '../components/WindowStrip.astro';
import Base from '../layouts/Base.astro';
import {
  WINDOW_DAYS,
  byStart,
  coverageText,
  easternText,
  inWindow,
  isWatched,
} from '../lib/radar.js';
import { generatedUtc } from '../lib/site-data-file.js';

const generated = await generatedUtc();
const jurisdictions = (await getCollection('jurisdictions')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'en'),
);
const names = new Map(jurisdictions.map((j) => [j.id, j.data.name]));
// Only a watched jurisdiction has hearings to check (issue #115); the others are listed below without freshness.
const watched = jurisdictions.filter((j) => isWatched(j.data.coverage_tier));
const others = jurisdictions.filter((j) => !isWatched(j.data.coverage_tier));
const events = byStart(
  (await getCollection('events')).filter((event) => inWindow(event.data, generated)),
);
---

<Base title="Hearing Radar">
  <Fragment slot="masthead">
    <h1>Hearing Radar</h1>
    <p class="lede">
      Meetings and hearings about data centers in the next {WINDOW_DAYS} days, as of{' '}
      <time datetime={generated}>{easternText(generated)}</time>. Every item was reviewed by a
      person and links to its official source.
    </p>
    <p class="feeds">
      Subscribe: <a href="/radar.ics">calendar (iCal)</a> · <a href="/feed.xml">feed (RSS)</a> ·
      download meetings: <a href="/events.csv">CSV</a> · <a href="/events.parquet">Parquet</a>;
      decisions: <a href="/actions.csv">CSV</a> · <a href="/actions.parquet">Parquet</a> · see them
      on the <a href="/map/">map</a>
    </p>
    <p class="feeds">
      The radar lists a meeting once its agenda posts. Dates the record already states, such as when
      a moratorium ends, are on <a href="/ahead/">Coming up on the record</a>.
    </p>
  </Fragment>

  <WindowStrip generatedUtc={generated} events={events} />

  <EventTable caption="Upcoming items, soonest first" events={events} jurisdictions={names} />

  <h2>Jurisdictions</h2>
  <ul class="freshness-list">
    {watched.map(({ id, data }) => (
      <li>
        <a href={`/jurisdictions/${id}/`}>{data.name}</a>
        <Freshness
          lastCheckedUtc={data.last_checked_utc}
          stale={data.stale}
          staleAfterHours={data.stale_after_hours}
        />
      </li>
    ))}
  </ul>

  {others.length > 0 && (
    <>
      <h2>Other jurisdictions</h2>
      <p>Their hearings are not on the radar.</p>
      <ul class="freshness-list">
        {others.map(({ id, data }) => (
          <li>
            <a href={`/jurisdictions/${id}/`}>{data.name}</a>
            <p>{coverageText(data.coverage_tier)}</p>
          </li>
        ))}
      </ul>
    </>
  )}
</Base>
