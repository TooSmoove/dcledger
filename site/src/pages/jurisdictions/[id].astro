---
// One page per jurisdiction: its coverage tier in words (issue #115) and its decisions (issue #25). A watched
// jurisdiction also shows freshness (SPEC AC10), its calendar feed and every one of its items, newest first; the
// other tiers have no hearing watch, so they show none of those.
import { getCollection, getEntry } from 'astro:content';
import Decisions from '../../components/Decisions.astro';
import EventTable from '../../components/EventTable.astro';
import Freshness from '../../components/Freshness.astro';
import Base from '../../layouts/Base.astro';
import { byDecisionNewestFirst, byStart, coverageText, isWatched } from '../../lib/radar.js';

export async function getStaticPaths() {
  return (await getCollection('jurisdictions')).map((j) => ({ params: { id: j.id } }));
}

const { id } = Astro.params;
const jurisdiction = await getEntry('jurisdictions', id);
if (!jurisdiction) {
  throw new Error(`No jurisdiction ${id} in events.json.`);
}
const { data } = jurisdiction;
const watched = isWatched(data.coverage_tier);
const events = byStart(
  (await getCollection('events')).filter((event) => event.data.jurisdiction_id === id),
).reverse();
const decisions = byDecisionNewestFirst(
  (await getCollection('actions')).filter((action) => action.data.jurisdiction_id === id),
);
---

<Base title={data.name}>
  <Fragment slot="masthead">
    <p class="back">
      <a href="/radar/">← Hearing Radar</a>
    </p>
    <h1>{data.name}</h1>
    <p class="coverage lede">{coverageText(data.coverage_tier)}</p>
    {watched && (
      <>
        <Freshness
          lastCheckedUtc={data.last_checked_utc}
          stale={data.stale}
          staleAfterHours={data.stale_after_hours}
        />
        <p class="feeds">
          Subscribe: <a href={`/radar/${id}.ics`}>calendar (iCal) for {data.name}</a>
        </p>
      </>
    )}
  </Fragment>

  {watched && (
    <>
      <EventTable
        caption={`Every reviewed item for ${data.name}, newest first`}
        events={events}
        jurisdictions={new Map([[id, data.name]])}
        showJurisdiction={false}
      />
    </>
  )}

  <Decisions actions={decisions} heading="Decisions, newest first" linkMeetings={true} />
</Base>
