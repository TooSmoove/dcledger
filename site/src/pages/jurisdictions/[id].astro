---
// One page per jurisdiction: its coverage tier in words (issue #115) and its decisions (issue #25). A watched
// jurisdiction also shows freshness (SPEC AC10), its calendar feed and every one of its items, newest first; the
// other tiers have no hearing watch, so they show none of those. A note about the record that isn't one of the
// body's decisions, such as a court order on a moratorium, shows with its sources (AC2) before the decisions, and each
// decision links back to it (#note), so a reader who arrives at a #decision- anchor sees there is one.
import { getCollection, getEntry } from 'astro:content';
import Decisions from '../../components/Decisions.astro';
import EventTable from '../../components/EventTable.astro';
import Freshness from '../../components/Freshness.astro';
import Locator from '../../components/Locator.astro';
import Sources from '../../components/Sources.astro';
import Base from '../../layouts/Base.astro';
import { knownDates } from '../../lib/ahead.js';
import { byDecisionNewestFirst, byStart, coverageText, isWatched } from '../../lib/radar.js';
import { generatedUtc } from '../../lib/site-data-file.js';

export async function getStaticPaths() {
  return (await getCollection('jurisdictions')).map((j) => ({ params: { id: j.id } }));
}

const { id } = Astro.params;
const jurisdiction = await getEntry('jurisdictions', id);
if (!jurisdiction) {
  throw new Error(`No jurisdiction ${id} in events.json.`);
}
const { data } = jurisdiction;
const watched = isWatched(data.coverage_tier);
const events = byStart(
  (await getCollection('events')).filter((event) => event.data.jurisdiction_id === id),
).reverse();
const decisions = byDecisionNewestFirst(
  (await getCollection('actions')).filter((action) => action.data.jurisdiction_id === id),
);
// Its known dates (ADR-0010): worked out from all events, since a meeting that day records a next step.
const known = knownDates(decisions, await getCollection('events'), await generatedUtc());
const hasUpcoming = known.some((k) => k.state === 'upcoming');
// Watched and decisions-only jurisdictions each have a known-date calendar (ADR-0010 Decision 4).
const hasAheadCalendar = data.coverage_tier === 'watched' || data.coverage_tier === 'decisions';
---

<Base title={data.name}>
  <Fragment slot="masthead">
    <p class="back">
      <a href="/radar/">← Hearing Radar</a>
    </p>
    <h1>{data.name}</h1>
    <p class="coverage lede">{coverageText(data.coverage_tier)}</p>
    {watched && (
      <>
        <Freshness
          lastCheckedUtc={data.last_checked_utc}
          stale={data.stale}
          staleAfterHours={data.stale_after_hours}
        />
        <p class="feeds">
          Subscribe: <a href={`/radar/${id}.ics`}>calendar (iCal) for {data.name}</a>
        </p>
      </>
    )}
    {hasAheadCalendar && (
      <p class="feeds">
        Dates on the record:{' '}
        <a href={`/ahead/${id}.ics`}>calendar (iCal) of dates ahead for {data.name}</a>
        {hasUpcoming && (
          <>
            {' '}
            · <a href="/ahead/">Coming up on the record</a>
          </>
        )}
      </p>
    )}
  </Fragment>

  <Locator id={id} name={data.name} />

  {watched && (
    <>
      <EventTable
        caption={`Every reviewed item for ${data.name}, newest first`}
        events={events}
        jurisdictions={new Map([[id, data.name]])}
        showJurisdiction={false}
      />
    </>
  )}

  {data.note !== null && (
    <section aria-labelledby="note-heading" class="jurisdiction-note" id="note">
      <h2 id="note-heading">Note on the record</h2>
      <p>{data.note}</p>
      <p class="muted">Not a decision of {data.name}. Stated in the sources below.</p>
      <h3>Sources</h3>
      <Sources documents={data.note_documents} />
    </section>
  )}

  <Decisions
    actions={decisions}
    heading="Decisions, newest first"
    linkMeetings={true}
    note={data.note !== null ? { href: '#note', jurisdictionName: data.name } : null}
    knownDates={known}
  />
</Base>
