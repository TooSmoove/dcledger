{
  "name": "dcledger-site",
  "private": true,
  "type": "module",
  "description": "Static site for dc-ledger's Hearing Radar. Reads only out/site-data/ (ADR-0001, ADR-0004).",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "fixture": "node scripts/use-fixture.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/copy-feeds.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:e2e": "node --test e2e/smoke.mjs",
    "lighthouse": "lhci autorun",
    "a11y": "node scripts/quality/axe.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "astro": "7.4.4",
    "maplibre-gl": "6.16.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@lhci/cli": "0.15.1",
    "axe-core": "4.14.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
