{
  "name": "dcledger-site",
  "private": true,
  "type": "module",
  "description": "Static site for dc-ledger's Hearing Radar. Reads only out/site-data/ (ADR-0001, ADR-0004).",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "fixture": "node scripts/use-fixture.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/copy-feeds.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
